<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme: AppCompat (for the activity) with every framework dialog restyled to the app's dark panel look. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#FF0A1520</item>
        <item name="android:alertDialogTheme">@style/DmrDialog</item>
        <item name="android:dialogTheme">@style/DmrDialog</item>
        <item name="alertDialogTheme">@style/DmrDialog</item>
        <item name="colorAccent">#FF00E5FF</item>
        <item name="android:colorAccent">#FF00E5FF</item>
        <item name="android:textColorHighlight">#5500E5FF</item>
    </style>

    <style name="DmrDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorBackground">#FF0A1520</item>
        <item name="android:colorAccent">#FF00E5FF</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#FFBFC8D0</item>
        <item name="android:textColor">#FFE8EEF2</item>
        <item name="android:textColorAlertDialogListItem">#FFE8EEF2</item>
        <item name="android:windowTitleStyle">@style/DmrDialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/DmrDialogButton</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>

    <style name="DmrDialogTitle" parent="android:TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">#FF00E5FF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DmrDialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">#FF00E5FF</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
